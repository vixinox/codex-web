# Public App origin used for remote enrollment links and Passkey RP validation.
# Required by Owner when CODEX_REMOTE_RELAY_URL is configured; production must use HTTPS.
CODEX_APP_ORIGIN=https://codex.example.com

# Public Relay WebSocket address. Owner connects to it, and Vite exposes only this value
# to the browser bundle. Configure the same URL in the Owner and frontend build environments.
CODEX_REMOTE_RELAY_URL=wss://relay.example.com/ws

# Shared Owner/Relay admission secret. Set the same random value in both services.
# Must contain at least 32 characters. Never expose this value to the frontend.
RELAY_OWNER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Optional: set true to show the startup landing page instead of opening the workspace directly.
VITE_ENABLE_STARTUP_PAGE=true

# Optional logging level: debug, info, warn, or error (default: info).
LOG_LEVEL=info
