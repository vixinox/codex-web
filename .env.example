BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SERVER_HOST=127.0.0.1
SERVER_PORT=3000
PUBLIC_HOST=localhost

# App/WebAuthn profile. Development defaults are localhost; production must set the HTTPS origin
# and matching RP ID explicitly.
CODEX_APP_ORIGIN=http://localhost:5173
CODEX_APP_RP_ID=localhost

# Optional project landing page. When false, unauthenticated users go directly to login.
# VITE_ENABLE_STARTUP_PAGE=false

CODEX_DATA_ROOT=./.data/codex
CODEX_MAX_ACTIVE_TASKS_PER_USER=2
CODEX_ALLOWED_OUTBOUND_SCHEMES=https
CODEX_ALLOWED_OUTBOUND_HOSTS=api.openai.com
CODEX_REQUIRE_DANGEROUS_ACCESS_CONFIRMATION=false
CODEX_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-secret

# Configure both values only when enabling remote Relay transport. The Owner connects outbound
# over WSS; RELAY_OWNER_TOKEN must match CODEX_REMOTE_RELAY_OWNER_TOKEN (at least 32 characters).
CODEX_REMOTE_RELAY_URL=wss://relay.example.com/ws
CODEX_REMOTE_RELAY_OWNER_TOKEN=replace-with-a-random-relay-admission-token

# Vite exposes the Relay endpoint to the browser. Keep it aligned with CODEX_REMOTE_RELAY_URL.
VITE_CODEX_REMOTE_RELAY_URL=wss://relay.example.com/ws

# Relay deployment uses the same value as CODEX_REMOTE_RELAY_OWNER_TOKEN.
RELAY_OWNER_TOKEN=replace-with-a-random-relay-admission-token

# Relay listener. Keep RELAY_HOST behind a TLS-terminating proxy for public deployments.
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# Relay limits. Defaults shown; values must be positive integers.
RELAY_MAX_CONNECTIONS=10000
RELAY_MAX_CLIENTS_PER_NODE=8
RELAY_MAX_FRAME_BYTES=2097152
RELAY_MESSAGES_PER_SECOND=250
RELAY_MAX_QUEUED_BYTES=8388608

LOG_LEVEL=info