{
  "name": "codex-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-port.mjs 5173 vite",
    "server:owner": "node scripts/run-with-env.mjs tsx server/owner/server.ts",
    "server:guest": "node scripts/run-with-env.mjs tsx server/guest/server.ts",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx scripts/reset-local-database.ts && pnpm db:push --force",
    "account:create": "tsx scripts/create-account.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint . --quiet",
    "lint:staged": "node scripts/lint-staged-warnings.mjs",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "test": "tsx --test server/**/*.test.ts",
    "test:bridge": "tsx --test server/app.test.ts server/codex/*.test.ts server/security.test.ts server/thread-contract.test.ts",
    "test:frontend": "vitest run",
    "test:integration": "tsx --test server/**/*.integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fastify/sensible": "^6.0.5",
    "@lexical/code": "^0.50.0",
    "@lexical/history": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.4",
    "gsap": "3.15.0",
    "lexical": "^0.50.0",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
