{
  "name": "codex-web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @codex-web/app dev",
    "relay": "pnpm --filter @codex-web/relay dev",
    "server": "pnpm --filter @codex-web/server start",
    "db:push": "pnpm --filter @codex-web/server db:push",
    "db:reset": "pnpm --filter @codex-web/server db:reset",
    "manage": "pnpm --filter @codex-web/server manage",
    "build": "pnpm --recursive --if-present build",
    "preview": "pnpm --filter @codex-web/app preview",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "oxlint . --quiet --max-warnings=10000",
    "lint:architecture": "oxlint packages/server/src --config .oxlintrc.architecture.json --quiet --max-warnings=10000",
    "lint:staged": "node scripts/lint-staged-warnings.mjs",
    "quality:report": "node scripts/quality-timing.mjs --mode report",
    "quality:check": "node scripts/quality-timing.mjs --mode check --commands lint,typecheck,test",
    "quality:calibrate": "node scripts/quality-timing.mjs --mode calibrate",
    "schema:update": "node scripts/update-app-server-schema.mjs",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "test": "pnpm --recursive --parallel --workspace-concurrency=3 --if-present test && pnpm test:tools",
    "test:core": "pnpm --recursive --parallel --workspace-concurrency=3 --filter @codex-web/server --filter @codex-web/protocol --filter @codex-web/relay test",
    "test:tools": "node --test scripts/*.test.mjs",
    "test:server": "pnpm --filter @codex-web/server test",
    "test:protocol": "pnpm --filter @codex-web/protocol test",
    "test:relay": "pnpm --filter @codex-web/relay test",
    "test:conversation": "pnpm --filter @codex-web/conversation test",
    "test:telemetry": "pnpm --filter @codex-web/telemetry test",
    "test:frontend": "pnpm --filter @codex-web/app test"
  },
  "devDependencies": {
    "oxfmt": "0.64.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2008"
  }
}
