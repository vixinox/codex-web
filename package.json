{
  "name": "codex-web",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @codex-web/app dev",
    "relay": "pnpm --filter @codex-web/relay dev",
    "server:owner": "pnpm --filter @codex-web/server start",
    "db:push": "pnpm --filter @codex-web/server db:push",
    "db:reset": "pnpm --filter @codex-web/server db:reset",
    "account:create": "pnpm --filter @codex-web/server account:create",
    "build": "pnpm --recursive --if-present build",
    "preview": "pnpm --filter @codex-web/app preview",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "oxlint . --quiet",
    "lint:staged": "node scripts/lint-staged-warnings.mjs",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "test": "pnpm --filter @codex-web/server test && pnpm --filter @codex-web/protocol test && pnpm --filter @codex-web/relay test",
    "test:server": "pnpm --filter @codex-web/server test",
    "test:protocol": "pnpm --filter @codex-web/protocol test",
    "test:relay": "pnpm --filter @codex-web/relay test",
    "test:frontend": "pnpm --filter @codex-web/app test",
    "test:integration": "pnpm --filter @codex-web/server test:integration"
  },
  "devDependencies": {
    "oxfmt": "0.64.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
