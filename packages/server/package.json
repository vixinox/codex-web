{
  "name": "@codex-web/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/run-with-env.mjs tsx src/owner/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --test src/**/*.integration.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:reset": "node scripts/run-with-env.mjs tsx scripts/reset-local-database.ts",
    "manage": "node scripts/run-with-env.mjs tsx scripts/owner-cli.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@codex-web/protocol": "workspace:*",
    "@codex-web/telemetry": "workspace:*",
    "@fastify/sensible": "^6.0.5",
    "@fastify/websocket": "^11.3.4",
    "@simplewebauthn/server": "14.0.3",
    "@vincentkoc/qrcode-tui": "^0.2.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
